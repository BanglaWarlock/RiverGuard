# Shown are the information needed to run the reporter program.
# Fill up the information and rename file to '.env'. 
# Never commit your .env file to the repository, ensure gitignore is already configured.



DB_URI=     # example : mongodb://localhost:27017 or connection string from MongoDB Atlas
DB_NAME=    # example : RiverGuard, database name to use to save the data.
WINDOW_HOURS=       # window of 1 report ie 24 for a report per 24 hrs
RECIPIENTS=     #recipient list separated by comma ie "a@b.com,c@d.com"
SMTP_HOST=      # e.g. smtp.gmail.com
SMTP_PORT=      #e.g. 465
SMTP_USER=      # the sender email ie e@gmail.com
SMTP_PASS=      # application password that bypasses 2 factor authentication
EMAIL_FROM=     # ie RiverGuard <your.address@gmail.com> the display of the sender