# Shown are the information needed to run the api program.
# Fill up the information and rename file to '.env'. 
# Never commit your .env file to the repository, ensure gitignore is already configured.

# Database configuration (specifically MongoDB)
DB_URI=     # example : mongodb://localhost:27017 or connection string from MongoDB Atlas
DB_NAME=    # example : RiverGuard, database name to use to save the data, should match where API pulls from.

# Redis configuration
REDIS_URL=  # example: redis://localhost:6379 , requires redis:// scheme in the URL

# API configuration
API_HOST=   # eg 0.0.0.0 for this machine
API_PORT=  # eg 8000 for the port to listen on   
CORS_ORIGINS= # eg * for all origins, or a comma-separated list of origins to allow cross-origin requests from

# SSE stream configuration
KEEPALIVE_SECONDS=15 # eg 15 for how long to send a "ping" to ensure the connection is still alive, in seconds